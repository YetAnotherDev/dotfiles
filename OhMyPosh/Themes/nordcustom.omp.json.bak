{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
      {
        "alignment": "left",
        "segments": [
          {
            "background": "#FFFBDA",
            "foreground": "#4C566A",
            "leading_diamond": "\u256d\u2500\ue0b6",
            "style": "diamond",
            "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
            "type": "os"
          },
          {
            "background": "#ED9455",
            "foreground": "#2E3440",
            "powerline_symbol": "\ue0b0",
            "properties": {
              "style": "full"
            },
            
            "style": "powerline",
            "template": " \uf07b {{ .Path }} ",
            "type": "path"
          },
          {
            "background": "#358503",
            "background_templates": [
              "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFFBDA{{ end }}",
              "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFFBDA{{ end }}",
              "{{ if gt .Ahead 0 }}#FFFBDA{{ end }}",
              "{{ if gt .Behind 0 }}#FFFBDA{{ end }}"
            ],
            "foreground": "#2E3440",
            "powerline_symbol": "\ue0b0",
            "properties": {
              "fetch_stash_count": true,
              "fetch_status": true,
              "fetch_upstream_icon": true
            },
            "style": "powerline",
            "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
            "type": "git"
          },
          {
            "type": "dotnet",
            "style": "powerline",
            "powerline_symbol": "",
            "foreground": "#000000",
            "background": "#FFBB70",
            "template": "  {{ .Full }} "
          }
        ],
        "type": "prompt"
      
      },
    

      {
        "alignment": "right",
        "segments": [
          {
            "background": "#358503",
            "background_templates": [
              "{{ if gt .Code 0 }}#f1184c{{ end }}"
            ],
            "foreground": "#2E3440",
            "trailing_diamond": "<transparent,background></>",
            "properties": {
              "always_enabled": true
            },
            "style": "diamond",
            "template": " {{ if gt .Code 0 }}\uf00d {{ reason .Code }}{{ else }}\uf42e {{ end }} ",
            "leading_diamond": "\ue0b6",
            "type": "status"
          },
          {
            "type": "kubectl",
            "style": "diamond",
            "leading_diamond": "\ue0b2",
            "background": "#FFBB70",
            "foreground": "#2E3440",
            "template": " \u2388 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
            "cache_timeout": 10,
            "properties": {
              "context_aliases": {
                "aks-prod-cluster": "Prod",
                "aks-nonprod-cluster": "NonProd"
              }
            }
          },
          {
            "background": "#ED9455",
            "foreground": "#2E3440",
            
            "leading_diamond": "\ue0b2",
            "properties": {
              "always_enabled": true
            },
            
            "style": "diamond",
            "template": "  {{ .FormattedMs }} ",
            "type": "executiontime"
          },
          {
            "background": "#FFFBDA",
            "foreground": "#2E3440",
            "invert_powerline": true,
            "leading_diamond": "\ue0b2",
            "style": "diamond",
            "template": " \ue641 {{ .CurrentDate | date .Format }} ",
            "trailing_diamond": "\ue0b4",
            "type": "time",
            "properties": {
              "time_format": "3:04PM"
            }
          }
        ],
        
        "type": "prompt"
      },
      {
        "alignment": "right",
        "segments": [
          {
            "background": "#B48EAD",
            "foreground": "#2E3440",
            "leading_diamond": " \ue0b6",
            "properties": {
              "fetch_package_manager": true,
              "npm_icon": " <#cc3a3a>\ue5fa</> ",
              "yarn_icon": " <#348cba>\ue6a7</>"
            },
            "style": "diamond",
            "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
            "trailing_diamond": "\ue0b4",
            "type": "node"
          }
        ],
        "type": "prompt"
      },
      {
        "alignment": "left",
        "newline": true,
        "segments": [ 
          {
            "foreground": "#ECEFF4",
            "style": "plain",
            "template": "\u2570\u2500",
            "type": "text"
          },
          {
            "foreground": "#8FBCBB",
            "foreground_templates": [
              "{{ if gt .Code 0 }}#ef5350{{ end }}"
            ],
            "properties": {
              "always_enabled": true
            },
            "style": "plain",
            "template": "❱ ",
            "type": "status"
          }
        ],
        "type": "prompt"
      }
    ],
    "transient_prompt": {
        "background": "transparent",
        "foreground": "#41FF00",
        "template": "❱ "
    },
    "version": 2
  }
  
